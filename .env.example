# Copy this to `.env` (which is gitignored) and fill in the values you have.
# The scanner backend (wf-scan-web) auto-loads .env on startup. Anything left
# blank simply stays disabled — the audit degrades honestly, never faked.

# ── needed for the MVP ───────────────────────────────────────────────────────
# Real Core Web Vitals (LCP/INP/CLS). Free: Google Cloud Console -> enable the
# "Chrome UX Report API" -> create an API key. Blank = performance section off.
CRUX_API_KEY=

# Model B real fix uses the `claude` CLI logged into your Claude subscription
# (run `claude` once and /login). NO API key needed here.

# ── later: full pipeline paid/OAuth providers (not used by the MVP yet) ───────
# DataForSEO (on-page crawl, rank, keywords, backlinks, LLM mentions, GBP) — paid.
# The API login + API password from app.dataforseo.com -> API Access (not the
# account password). A paid tool runs only when both are set, PAUSE_SPEND is not
# 1, the tool was selected, and the web daily budget (SCAN_DAILY_BUDGET_USD)
# admits it. Anything short of that shows the tool as "did not run: <reason>".
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Kill switch: 1 refuses every paid call by name, at $0. Anything else = live.
DATAFORSEO_PAUSE_SPEND=
# Market for keyword/SERP/GBP lookups. 2840 = United States (default), 2116 = Cambodia.
DFS_LOCATION_CODE=
DFS_LANGUAGE_CODE=
# Bright Data SERP (rank/absence for seed queries) — paid
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=
# Google Search Console (impressions, CTR, cannibalization) — free, OAuth token
GSC_ACCESS_TOKEN=
GSC_SITE_URL=
